<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>BlackSunCyber.Updater</RootNamespace>
    <AssemblyName>BlackSunUpdater</AssemblyName>
    <!-- WinExe = ruleaza invizibil fara consola, compatibil cu toate versiunile Windows -->
    <!-- Publicat normal (nu single-file) pentru compatibilitate maxima cu Windows vechi -->
  </PropertyGroup>

  <ItemGroup>
    <Content Include="updatersettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
