<Window x:Class="BlackSunCyber.ClientAgent.WidgetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="BlackSun Cyber"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="False"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Width="220" Height="54">

    <Window.Resources>
        <LinearGradientBrush x:Key="BrandGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#8052FF" Offset="0"/>
            <GradientStop Color="#15846E" Offset="1"/>
        </LinearGradientBrush>
    </Window.Resources>

    <Grid>
        <!-- ===== STAREA MINIMIZATA ===== -->
        <Border x:Name="MiniView"
                CornerRadius="26"
                BorderThickness="1"
                Visibility="Visible"
                MouseDown="Mini_MouseDown"
                MouseEnter="Mini_MouseEnter"
                MouseLeave="Mini_MouseLeave">
            <Border.Background>
                <SolidColorBrush Color="#E5080810"/>
            </Border.Background>
            <Border.BorderBrush>
                <SolidColorBrush Color="#558052FF"/>
            </Border.BorderBrush>
            <Border.Effect>
                <DropShadowEffect Color="#8052FF" Opacity="0.28"
                                  BlurRadius="14" ShadowDepth="0"/>
            </Border.Effect>

            <Grid Margin="12,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Mini logo dot (sun icon hint) -->
                <Grid Grid.Column="0" Width="18" Height="18"
      VerticalAlignment="Center" Margin="0,0,8,0">

                    <Rectangle RadiusX="4.5" RadiusY="4.5">
                        <Rectangle.Fill>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#8052FF" Offset="0"/>
                                <GradientStop Color="#5B3DF0" Offset="1"/>
                            </LinearGradientBrush>
                        </Rectangle.Fill>
                        <Rectangle.Effect>
                            <DropShadowEffect Color="#8052FF" BlurRadius="10" Opacity="0.5" ShadowDepth="0"/>
                        </Rectangle.Effect>
                    </Rectangle>

                    <Path HorizontalAlignment="Center" VerticalAlignment="Center">
        <Path.Fill>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#0D0D0D" Offset="0"/>
                <GradientStop Color="#2B2B2B" Offset="1"/>
            </LinearGradientBrush>
        </Path.Fill>
        <Path.Data>
            <CombinedGeometry GeometryCombineMode="Exclude">
                <CombinedGeometry.Geometry1>
                    <EllipseGeometry Center="4,4" RadiusX="4" RadiusY="4"/>
                </CombinedGeometry.Geometry1>
                <CombinedGeometry.Geometry2>
                    <EllipseGeometry Center="5.5,3" RadiusX="3.25" RadiusY="3.25"/>
                </CombinedGeometry.Geometry2>
            </CombinedGeometry>
        </Path.Data>
        <Path.Effect>
            <DropShadowEffect Color="Black" BlurRadius="2.5" Opacity="0.4" ShadowDepth="0.5"/>
        </Path.Effect>
    </Path>

</Grid>

                <!-- Status LED -->
                <Ellipse Grid.Column="1" Width="6" Height="6"
                         x:Name="StatusDot" Fill="#2ECC71"
                         VerticalAlignment="Center" Margin="0,0,7,0">
                    <Ellipse.Effect>
                        <DropShadowEffect Color="#2ECC71" Opacity="0.8" BlurRadius="6" ShadowDepth="0"/>
                    </Ellipse.Effect>
                </Ellipse>

                <!-- Timer -->
                <TextBlock Grid.Column="2" x:Name="MiniTimer"
                           Text="00:00:00" FontFamily="Consolas"
                           FontSize="16" FontWeight="Bold"
                           Foreground="#2ECC71" VerticalAlignment="Center">
                    <TextBlock.Effect>
                        <DropShadowEffect Color="#2ECC71" Opacity="0.45" BlurRadius="8" ShadowDepth="0"/>
                    </TextBlock.Effect>
                </TextBlock>

                <!-- Expand icon -->
                <TextBlock Grid.Column="3" x:Name="ExpandIcon"
                           Text="⊞" FontSize="12" Foreground="#556688"
                           VerticalAlignment="Center" Margin="6,0,2,0"
                           Visibility="Collapsed"/>
            </Grid>
        </Border>

        <!-- ===== STAREA EXPANDATA (cabinet complet) ===== -->
        <Border x:Name="ExpandedView"
                CornerRadius="18"
                BorderThickness="1"
                Visibility="Collapsed">
            <Border.Background>
                <SolidColorBrush Color="#F2080812"/>
            </Border.Background>
            <Border.BorderBrush>
                <SolidColorBrush Color="#668052FF"/>
            </Border.BorderBrush>
            <Border.Effect>
                <DropShadowEffect Color="#8052FF" Opacity="0.3"
                                  BlurRadius="28" ShadowDepth="0"/>
            </Border.Effect>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="44"/>
                    <RowDefinition Height="560"/>
                </Grid.RowDefinitions>

                <!-- Header cabinet -->
                <Border Grid.Row="0"
                        BorderBrush="#1A1A3A" BorderThickness="0,0,0,1"
                        CornerRadius="18,18,0,0">
                    <Border.Background>
                        <SolidColorBrush Color="#CC0C0C20"/>
                    </Border.Background>
                    <Grid Margin="12,0,8,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Mini sun logo -> replaced with moon logo -->
                        <Viewbox Width="20" Height="20" Margin="0,0,8,0">
                            <Grid Width="72" Height="72">
                                <Rectangle RadiusX="18" RadiusY="18" Fill="{StaticResource BrandGradient}">
                                    <Rectangle.Effect>
                                        <DropShadowEffect Color="#8052FF" BlurRadius="40" Opacity="0.5" ShadowDepth="0"/>
                                    </Rectangle.Effect>
                                </Rectangle>
                                <Path HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Path.Fill>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="#0D0D0D" Offset="0"/>
                                            <GradientStop Color="#2B2B2B" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Path.Fill>
                                    <Path.Data>
                                        <CombinedGeometry GeometryCombineMode="Exclude">
                                            <CombinedGeometry.Geometry1>
                                                <EllipseGeometry Center="16,16" RadiusX="16" RadiusY="16"/>
                                            </CombinedGeometry.Geometry1>
                                            <CombinedGeometry.Geometry2>
                                                <EllipseGeometry Center="22,12" RadiusX="13" RadiusY="13"/>
                                            </CombinedGeometry.Geometry2>
                                        </CombinedGeometry>
                                    </Path.Data>
                                    <Path.Effect>
                                        <DropShadowEffect Color="Black" BlurRadius="10" Opacity="0.4" ShadowDepth="1"/>
                                    </Path.Effect>
                                </Path>
                            </Grid>
                        </Viewbox>

                        <!-- Brand name -->
                        <TextBlock Grid.Column="1"
                                   Text="BlackSun Cyber"
                                   FontSize="12" FontWeight="Bold"
                                   Foreground="#FFB829" VerticalAlignment="Center"
                                   Margin="0,0,12,0"/>

                        <!-- Welcome text -->
                        <TextBlock Grid.Column="2" x:Name="WelcomeText"
                                   Text="Salut!" FontSize="11"
                                   Foreground="#6A6A8A" VerticalAlignment="Center"/>

                        <!-- Timer -->
                        <TextBlock Grid.Column="3" x:Name="ExpandedTimer"
                                   Text="00:00:00" FontFamily="Consolas"
                                   FontSize="15" FontWeight="Bold"
                                   Foreground="#2ECC71" VerticalAlignment="Center"
                                   Margin="0,0,10,0">
                            <TextBlock.Effect>
                                <DropShadowEffect Color="#2ECC71" Opacity="0.4" BlurRadius="7" ShadowDepth="0"/>
                            </TextBlock.Effect>
                        </TextBlock>

                        <!-- Close / minimize button -->
                        <StackPanel Grid.Column="4" Orientation="Horizontal"
            VerticalAlignment="Center" Margin="4,0,2,0">
                            <Button Content="—" Width="32" Height="28"
            Background="Transparent" BorderThickness="0"
            Foreground="#6A6A8A" FontSize="13"
            Click="CollapseBtn_Click" Cursor="Hand"
            ToolTip="Minimizează la widget mic"/>
                            <Button Content="□" Width="32" Height="28"
            Background="Transparent" BorderThickness="0"
            Foreground="#6A6A8A" FontSize="13"
            Click="ReturnToMainCabinet_Click" Cursor="Hand"
            ToolTip="Înapoi la cabinetul personal"/>
                            <Button Content="✕" Width="32" Height="28"
            Background="Transparent" BorderThickness="0"
            Foreground="#6A6A8A" FontSize="13"
            Click="CollapseBtn_Click" Cursor="Hand"
            ToolTip="Închide cabinetul"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- WebView2 cu portalul client -->
                <wv2:WebView2 Grid.Row="1" x:Name="CabinetWebView"
                              Source="about:blank"/>
            </Grid>
        </Border>
    </Grid>
</Window>
