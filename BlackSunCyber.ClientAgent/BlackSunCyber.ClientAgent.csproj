<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>WinExe</OutputType>
		<TargetFramework>net10.0-windows</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<UseWPF>true</UseWPF>
		<RootNamespace>BlackSunCyber.ClientAgent</RootNamespace>
	</PropertyGroup>

	<ItemGroup>
		<!-- SignalR pentru comunicare live cu serverul -->
		<PackageReference Include="Microsoft.AspNetCore.SignalR.Client" Version="8.0.0" />
		<!-- WebView2: browser Chromium embedded in WPF, pentru portalul client integrat -->
		<PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2739.15" />
	</ItemGroup>

	<ItemGroup>
		<Content Include="agentsettings.json">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</Content>
	</ItemGroup>

</Project>